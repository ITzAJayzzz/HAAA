# Copy to .env and fill in your values
SECRET_KEY=global-chat-secret-key-123xyz

# Firebase
FIREBASE_CRED_PATH=serviceAccountKey.json
FIREBASE_DB_URL=https://global-chat-cfe60-default-rtdb.firebaseio.com

# Server
PORT=5000
FLASK_ENV=production

# CORS — comma-separated origins, or * for all
ALLOWED_ORIGINS=*

# Optional Redis for rate-limiter persistence
# REDIS_URL=redis://localhost:6379
